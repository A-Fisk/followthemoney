# Copy this to .env and fill in your values
# .env is gitignored — never commit it

# ABR ABN Lookup API — register at https://abr.business.gov.au/Tools/WebServices
ABR_GUID=your-guid-here

# They Vote For You API — register at https://theyvoteforyou.org.au/help/data
TVFY_API_KEY=your-key-here

# Database (defaults work with docker compose)
DATABASE_URL=postgresql://ftm:ftm@localhost:5432/followthemoney

# LLM — used for ambiguous donor review and gift extraction fallback
# Anthropic (default):
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=your-anthropic-key-here
LLM_MODEL=claude-haiku-4-5-20251001
# Ollama (local):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2
